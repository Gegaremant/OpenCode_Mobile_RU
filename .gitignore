# Local-only artefacts. trash/ holds the working leftovers (the upstream
# source snapshot and a .env that used to carry a live GitHub PAT) — none of it
# is ever meant to reach the repository, and ignoring the whole directory means
# that can no longer happen by accident.
/trash/

.env
.env.*
*.zip

# Nothing generated by a local build belongs here either.
node_modules/
original-src/
android/
*.keystore
*.jks
