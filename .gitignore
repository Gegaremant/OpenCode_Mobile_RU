# Local-only artefacts.
#
# .env holds a live GitHub PAT for local `gh` / `git push`. CI reads the same
# token from repository secrets (GIT_TOKEN), so the file has no business being
# tracked — and ignoring .env.* as well keeps .env.local and friends out.
.env
.env.*

# Upstream source snapshots, downloaded by hand. The workflow fetches the
# release it needs on its own.
*.zip
/trash/

# Nothing generated by a local build belongs here either.
node_modules/
original-src/
android/
dist/
*.keystore
*.jks
*.apk

# Session exports (backup-session.sh) — local transcripts of conversations,
# not repository content, and large.
SESSION-*.md
SESSION-*.json
*_session.md
*_session.yaml

# Python bytecode from scripts/.
__pycache__/
*.pyc
