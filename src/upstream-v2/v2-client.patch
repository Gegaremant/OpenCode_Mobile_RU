+      default:
+        return []
+    }
+  }
+}
+
+function parsedToolInput(buf: ToolBuf): unknown {
+  if (!buf.input) return undefined
+  try {
+    return JSON.parse(buf.input)
+  } catch {
+    return buf.input
+  }
