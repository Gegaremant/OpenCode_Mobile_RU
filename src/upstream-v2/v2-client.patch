+import assert from "node:assert/strict"
+import test from "node:test"
+
+import { hasSelectableContent, messagePartsToSelectableText } from "./message-text.ts"
+
+import type { Part } from "./sdk.ts"
+
+test("flattens text, reasoning and tool parts in order", () => {
+  const parts: Part[] = [
+    { id: "t1", messageID: "m1", type: "text", text: "Working on it." },
+    { id: "r1", messageID: "m1", type: "reasoning", text: "Need to read the file first." },
+    {
+      id: "tool1",
+      messageID: "m1",
+      type: "tool",
+      tool: "read",
+      callID: "call_1",
+      state: { status: "completed", input: { path: "a.ts" }, output: "file contents" },
+    },
+    { id: "t2", messageID: "m1", type: "text", text: "Done." },
+  ]
+
+  const text = messagePartsToSelectableText(parts)
+  assert.equal(
+    text,
+    [
+      "Working on it.",
+      "Thinking:\nNeed to read the file first.",
+      'Tool: read\nInput:\n{\n  "path": "a.ts"\n}\nResult:\nfile contents',
+      "Done.",
+    ].join("\n\n"),
+  )
+})
+
+test("tool errors render as Error blocks", () => {
+  const parts: Part[] = [
+    {
+      id: "tool1",
+      messageID: "m1",
+      type: "tool",
+      tool: "bash",
+      state: { status: "error", input: { command: "exit 1" }, error: { message: "exit code 1" } },
+    },
+  ]
+
+  const text = messagePartsToSelectableText(parts)
+  assert.equal(text, "Tool: bash\nInput:\n{\n  \"command\": \"exit 1\"\n}\nError:\nexit code 1")
+})
+
+test("custom labels are used (i18n)", () => {
+  const parts: Part[] = [{ id: "r1", messageID: "m1", type: "reasoning", text: "hmm" }]
+  const text = messagePartsToSelectableText(parts, {
+    thinking: "思考过程",
+    tool: "工具",
+    input: "输入",
+    result: "结果",
+    error: "错误",
+    file: "文件",
+  })
+  assert.equal(text, "思考过程:\nhmm")
+})
+
+test("empty and non-content parts produce empty text", () => {
+  const parts: Part[] = [
+    { id: "s1", messageID: "m1", type: "step-start" },
+    { id: "t1", messageID: "m1", type: "text", text: "" },
+  ]
+  assert.equal(messagePartsToSelectableText(parts), "")
+  assert.equal(hasSelectableContent(parts), false)
+})
+
+test("hasSelectableContent detects reasoning-only and tool-only messages", () => {
+  assert.equal(hasSelectableContent([{ id: "r", messageID: "m", type: "reasoning", text: "x" }]), true)
+  assert.equal(hasSelectableContent([{ id: "t", messageID: "m", type: "tool", tool: "read" }]), true)
+  assert.equal(hasSelectableContent([{ id: "f", messageID: "m", type: "file", filename: "shot.png" }]), true)
+})
diff --git a/src/lib/message-text.ts b/src/lib/message-text.ts
new file mode 100644
index 0000000..4f1ffb3
--- /dev/null
+++ b/src/lib/message-text.ts
@@ -0,0 +1,76 @@
+import type { Part } from "./sdk"
+
+// Plain-text rendering of a message's parts for the full-screen selection
+// sheet. Selection needs a single selectable <Text> (FlatList rows break
+// Android selection — react-native#46999), so every part kind is flattened
+// into one text blob: assistant text verbatim, reasoning under a "Thinking"
+// heading, tool calls as name + input + result/error blocks.
+
+export type SheetLabels = {
+  thinking: string
+  tool: string
+  input: string
+  result: string
+  error: string
+  file: string
+}
+
+const DEFAULT_LABELS: SheetLabels = {
+  thinking: "Thinking",
+  tool: "Tool",
+  input: "Input",
+  result: "Result",
+  error: "Error",
+  file: "File",
+}
+
+function formatValue(value: unknown): string {
+  if (typeof value === "string") return value
+  try {
+    return JSON.stringify(value, null, 2) ?? String(value)
+  } catch {
+    return String(value)
+  }
+}
+
+export function messagePartsToSelectableText(parts: Part[], labels: SheetLabels = DEFAULT_LABELS): string {
+  const blocks: string[] = []
+  for (const part of parts) {
+    if (part.type === "text") {
+      if (part.text) blocks.push(part.text)
+      continue
+    }
+    if (part.type === "reasoning") {
+      if (part.text) blocks.push(`${labels.thinking}:\n${part.text}`)
+      continue
+    }
+    if (part.type === "tool") {
+      const lines = [`${labels.tool}: ${part.tool || part.callID || "unknown"}`]
+      if (part.state?.input !== undefined) {
+        lines.push(`${labels.input}:\n${formatValue(part.state.input)}`)
+      }
+      if (part.state?.status === "error") {
+        lines.push(`${labels.error}:\n${part.state.error?.message || "Tool call failed"}`)
+      } else if (part.state?.output !== undefined) {
+        lines.push(`${labels.result}:\n${formatValue(part.state.output)}`)
+      }
+      blocks.push(lines.join("\n"))
+      continue
+    }
+    if (part.type === "file" && part.filename) {
+      blocks.push(`${labels.file}: ${part.filename}`)
+    }
+  }
+  return blocks.join("\n\n")
+}
+
+// True when a message has any part worth opening the selection sheet for.
+export function hasSelectableContent(parts: Part[]): boolean {
+  return parts.some(
+    (part) =>
+      (part.type === "text" && !!part.text) ||
+      (part.type === "reasoning" && !!part.text) ||
+      part.type === "tool" ||
+      (part.type === "file" && !!part.filename),
+  )
+}
