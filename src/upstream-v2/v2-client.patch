index 0000000..6c7d549
--- /dev/null
+++ b/src/lib/api-detect.test.ts
@@ -0,0 +1,81 @@
+import assert from "node:assert/strict"
+import { test } from "node:test"
+
+import { detectServerApi, isLegacyApi, type ProbeResponse } from "./api-detect.ts"
+
+// Every fixture below is a real response recorded on 2026-09-24 from a live server:
+// opencode v2.0.16 (100.77.13.76:4096) and opencode 1.18.32 (`opencode serve`).
+const SPA_HTML =
+  '<!doctype html> <html lang="en" style="background-color: var(--v2-background-bg-deep, #fafafa)"> <head>'
+
+function probe(responses: Record<string, ProbeResponse>) {
+  return async (path: string): Promise<ProbeResponse> => {
+    const found = responses[path]
+    if (!found) throw new Error(`probe not stubbed: ${path}`)
+    return found
+  }
+}
+
+test("detectServerApi reads a v2 server from its JSON /api/info", async () => {
+  const identity = await detectServerApi(
+    probe({
+      "/api/info": {
+        status: 200,
+        contentType: "application/json",
+        body: JSON.stringify({ version: "2.0.16", pid: 2967, urls: ["http://100.77.13.76:4096"] }),
+      },
+    }),
+  )
+  assert.deepEqual(identity, { api: "v2", version: "2.0.16" })
+})
+
+test("detectServerApi still classifies v2 when /api/info only answers 401", async () => {
+  // Recorded unauthenticated against v2.0.16: the route exists and demands a password,
+  // while every v1 route on the same host falls through to the SPA.
+  const identity = await detectServerApi(
+    probe({
+      "/api/info": { status: 401, contentType: "", body: "" },
+    }),
+  )
+  assert.deepEqual(identity, { api: "v2" })
+})
+
+test("detectServerApi falls back to /global/health for a v1 server", async () => {
+  // Recorded against 1.18.32: /api/info is not a route there, so it serves the SPA
+  // with a 200. Treating that 200 as a healthy v2 connection is the bug this guards.
+  const identity = await detectServerApi(
+    probe({
+      "/api/info": { status: 200, contentType: "text/html", body: SPA_HTML },
+      "/global/health": { status: 200, contentType: "application/json", body: '{"healthy":true,"version":"1.18.32"}' },
+    }),
+  )
+  assert.deepEqual(identity, { api: "v1", version: "1.18.32" })
+})
+
+test("detectServerApi classifies v1 when health demands a password", async () => {
+  const identity = await detectServerApi(
+    probe({
+      "/api/info": { status: 200, contentType: "text/html", body: SPA_HTML },
+      "/global/health": { status: 401, contentType: "", body: "" },
+    }),
+  )
+  assert.deepEqual(identity, { api: "v1" })
+})
+
+test("detectServerApi rejects a server that answers HTML everywhere", async () => {
+  await assert.rejects(
+    detectServerApi(
+      probe({
+        "/api/info": { status: 200, contentType: "text/html", body: SPA_HTML },
+        "/global/health": { status: 200, contentType: "text/html", body: SPA_HTML },
+      }),
+    ),
+    /neither \/api\/info \(v2\) nor \/global\/health \(v1\)/,
+  )
+})
+
+test("isLegacyApi only reports v1", () => {
+  assert.equal(isLegacyApi("v1"), true)
+  assert.equal(isLegacyApi("v2"), false)
+  assert.equal(isLegacyApi(undefined), false)
+})
diff --git a/src/lib/api-detect.ts b/src/lib/api-detect.ts
new file mode 100644
index 0000000..499fab2
--- /dev/null
+++ b/src/lib/api-detect.ts
@@ -0,0 +1,80 @@
+// Decide which server API a connection speaks, from the response envelope alone.
+//
+// Verified against live servers on 2026-09-24:
+//   opencode v2.0.16   GET /api/info       -> 401 (route exists, auth required)
+//                                          -> 200 application/json when authenticated
+//                      GET /global/health  -> 200 text/html   (SPA fall-through)
+//   opencode 1.18.32   GET /api/info       -> 200 text/html   (SPA fall-through)
+//                      GET /global/health  -> 200 application/json {healthy, version}
+//
+// The discriminator is the content type, never the status code: an unknown route on
+// either server answers 200 with the web SPA's HTML, which is exactly how a v1 server
+// used to pass v2's health check and then fail on every later request.
+//
+// Kept free of expo/fetch so it runs under plain `node --test` (same pattern as
+// api-error.ts / diagnostics-classify.ts).
+export type ServerApi = "v1" | "v2"
+
+export interface ServerIdentity {
+  api: ServerApi
+  version?: string
+}
+
+export interface ProbeResponse {
+  status: number
+  contentType: string
+  body: string
+}
+
+/** Fetch one path and report the envelope. Implemented by sdk.ts with expo/fetch. */
+export type ProbeRequest = (path: string) => Promise<ProbeResponse>
+
+function isJson(contentType: string): boolean {
+  return contentType.includes("application/json")
+}
+
+/** 401/403 means the route exists but wants credentials — a route that does not
+ *  exist would have fallen through to the SPA (200 HTML), so the API is known even
+ *  though the body is not readable. */
+function wantsAuth(status: number): boolean {
+  return status === 401 || status === 403
+}
+
+function versionFrom(body: string): string | undefined {
+  try {
+    const parsed = JSON.parse(body) as { version?: unknown }
+    return typeof parsed.version === "string" ? parsed.version : undefined
+  } catch {
+    return undefined
+  }
+}
+
+/** Classify a server from the two probes. Throws when neither route answers as JSON,
+ *  which means the endpoint is not an opencode server we can talk to. */
+export async function detectServerApi(probe: ProbeRequest): Promise<ServerIdentity> {
+  const info = await probe("/api/info")
+  if (isJson(info.contentType) && info.status < 300) {
+    return { api: "v2", version: versionFrom(info.body) }
+  }
+  if (wantsAuth(info.status)) {
+    return { api: "v2" }
+  }
+
+  const health = await probe("/global/health")
+  if (isJson(health.contentType) && health.status < 300) {
+    return { api: "v1", version: versionFrom(health.body) }
+  }
+  if (wantsAuth(health.status)) {
+    return { api: "v1" }
+  }
+
+  throw new Error(
+    "Unsupported server: neither /api/info (v2) nor /global/health (v1) answered with JSON. " +
+      "This looks like an opencode web page, not a server API.",
+  )
+}
+
+/** True when a detected server is old enough that v2-only affordances must be hidden. */
+export function isLegacyApi(api: ServerApi | undefined): boolean {
+  return api === "v1"
+}
